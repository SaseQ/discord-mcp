# The "Token" of your bot from `Developer Portal > your application > Bot > Reset Token`. Not the client ID or the client secret.
DISCORD_TOKEN=
# Optional. The server ID that tools use when the call gives no `guildId`.
DISCORD_GUILD_ID=

# `stdio` (default) or `http`.
DISCORD_MCP_TRANSPORT=stdio
# HTTP only. A bearer token of 32 or more characters, required when the host is not loopback. Example: `openssl rand -hex 32`
DISCORD_MCP_HTTP_TOKEN=

# Tool selectors: names, globs such as `delete_*`, `@read`, `@write`, `@destructive`, or a group such as `@moderation`.
# Empty `DISCORD_MCP_ALLOW` means every tool. `DISCORD_MCP_DENY` wins over `DISCORD_MCP_ALLOW`.
DISCORD_MCP_ALLOW=
DISCORD_MCP_DENY=@destructive

# Absolute folders that the `files` of the send tools and `create_emoji` may read. Empty turns off local file reads.
DISCORD_MCP_FILE_ROOTS=
